# URL pública del sitio, sin barra final (p. ej. https://jorgevega.dev).
# Se usa en las etiquetas canonical y Open Graph de index.html.
# Mientras esté vacía, esas URLs quedan relativas; ponla antes de publicar.
VITE_SITE_URL=https://vegatf.github.io/portfolio/

# Access key de Web3Forms (formulario de contacto). Es PÚBLICA por diseño: solo permite
# enviar mensajes al correo con el que se registró. Se usa en src/lib/sendContact.js.
VITE_WEB3FORMS_KEY=db8d0378-068c-400f-a7e5-746a46a10368
